# ==============================================================================
# Simple Finance — .gitignore
# This repository is PUBLIC. No real personal financial data may ever be
# committed: no databases, backups, receipts, exports, or credentials.
# Fictional demo/seed data lives in tracked source paths (e.g. src/lib/demo,
# prisma/seed) and must never be stored under the ignored runtime paths below.
# ==============================================================================

# --- Node / Next.js build artefacts ---
node_modules/
.next/
out/
build/
dist/
coverage/
*.tsbuildinfo

# --- Environment & secrets (NEVER commit) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# --- Runtime / real household data (NEVER commit) ---
data/
backups/
receipts/
uploads/
exports/
*.db
*.sqlite
*.sqlite3
*.dump
*.bak

# --- Logs ---
*.log
npm-debug.log*
yarn-error.log*

# --- OS / editor noise ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
